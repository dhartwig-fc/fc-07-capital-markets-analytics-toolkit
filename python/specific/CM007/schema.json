{
  "schema_name": "cm007_pump_and_dump_schema",
  "version": "1.0",
  "pattern_id": "CM007",
  "description": "Machine-readable schema for the CM007 Pump and Dump analytics workflow.",
  "datasets": {
    "trading_accounts": {
      "file": "trading_accounts.csv",
      "primary_key": "account_ref",
      "fields": {
        "trader_name": "string",
        "account_ref": "string",
        "instrument": "string",
        "pct_of_float_accumulated": "integer",
        "coordinated_posts_count": "integer",
        "price_peak": "number",
        "price_baseline": "number",
        "volume_sold_to_retail": "number",
        "total_position": "number",
        "promoter_name": "string",
        "promoter_id": "string"
      },
      "required": [
        "trader_name",
        "account_ref",
        "instrument",
        "pct_of_float_accumulated",
        "coordinated_posts_count",
        "price_peak",
        "price_baseline",
        "volume_sold_to_retail",
        "total_position",
        "promoter_name",
        "promoter_id"
      ]
    },
    "promoters": {
      "file": "promoters.csv",
      "primary_key": "account_ref",
      "fields": {
        "promoter_name": "string",
        "promoter_id": "string",
        "account_ref": "string",
        "channel": "string",
        "jurisdiction": "string",
        "prior_alerts": "integer"
      },
      "required": [
        "promoter_name",
        "promoter_id",
        "account_ref",
        "channel",
        "jurisdiction",
        "prior_alerts"
      ]
    }
  },
  "components": {
    "accumulation_concentration": {
      "weight": 0.35
    },
    "promotional_coordination": {
      "weight": 0.25
    },
    "price_inflation": {
      "weight": 0.20
    },
    "distribution_into_retail": {
      "weight": 0.20
    }
  },
  "band_scores": {
    "Low": 15,
    "Medium": 45,
    "High": 70,
    "Critical": 90
  },
  "thresholds": {
    "alert_threshold": 80
  },
  "risk_bands": {
    "low": {
      "min": 0,
      "max": 29
    },
    "medium": {
      "min": 30,
      "max": 59
    },
    "high": {
      "min": 60,
      "max": 79
    },
    "critical": {
      "min": 80,
      "max": 100
    }
  },
  "derived_fields": {
    "price_inflation_ratio": "price_peak / price_baseline",
    "distribution_into_retail_ratio": "volume_sold_to_retail / total_position",
    "exposure_score": "weighted sum of the four component band-midpoint scores"
  },
  "outputs": {
    "cm007_exposure_scores": {
      "file": "cm007_exposure_scores.csv"
    },
    "cm007_pump_and_dump_alerts": {
      "file": "cm007_pump_and_dump_alerts.csv"
    }
  }
}
