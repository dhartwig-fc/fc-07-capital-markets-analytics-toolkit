{
  "schema_name": "cm001_insider_trading_schema",
  "version": "1.0",
  "pattern_id": "CM001",
  "description": "Machine-readable schema for the CM001 Insider Trading analytics workflow.",
  "datasets": {
    "trading_accounts": {
      "file": "trading_accounts.csv",
      "primary_key": "account_ref",
      "fields": {
        "trader_name": "string",
        "account_ref": "string",
        "desk": "string",
        "issuer_name": "string",
        "normal_average_position": "number",
        "pre_event_position_increase": "number",
        "days_before_event": "integer",
        "contact_events_90d": "integer",
        "position_value_at_entry": "number",
        "realized_pnl": "number",
        "information_source_name": "string"
      },
      "required": [
        "trader_name",
        "account_ref",
        "desk",
        "issuer_name",
        "normal_average_position",
        "pre_event_position_increase",
        "days_before_event",
        "contact_events_90d",
        "position_value_at_entry",
        "realized_pnl",
        "information_source_name"
      ]
    },
    "information_sources": {
      "file": "information_sources.csv",
      "primary_key": "account_ref",
      "fields": {
        "information_source_name": "string",
        "account_ref": "string",
        "role": "string",
        "employer": "string",
        "jurisdiction": "string",
        "relationship": "string",
        "prior_alerts": "integer"
      },
      "required": [
        "information_source_name",
        "account_ref",
        "role",
        "employer",
        "jurisdiction",
        "relationship",
        "prior_alerts"
      ]
    }
  },
  "components": {
    "pre_event_position_build": {
      "weight": 0.35
    },
    "timing_proximity_to_event": {
      "weight": 0.25
    },
    "information_access_linkage": {
      "weight": 0.20
    },
    "profit_realisation": {
      "weight": 0.20
    }
  },
  "band_scores": {
    "Low": 15,
    "Medium": 45,
    "High": 70,
    "Critical": 90
  },
  "thresholds": {
    "alert_threshold": 80
  },
  "risk_bands": {
    "low": {
      "min": 0,
      "max": 29
    },
    "medium": {
      "min": 30,
      "max": 59
    },
    "high": {
      "min": 60,
      "max": 79
    },
    "critical": {
      "min": 80,
      "max": 100
    }
  },
  "derived_fields": {
    "pre_event_position_build_ratio": "pre_event_position_increase / normal_average_position",
    "profit_realisation_ratio": "realized_pnl / position_value_at_entry",
    "exposure_score": "weighted sum of the four component band-midpoint scores"
  },
  "outputs": {
    "cm001_exposure_scores": {
      "file": "cm001_exposure_scores.csv"
    },
    "cm001_insider_trading_alerts": {
      "file": "cm001_insider_trading_alerts.csv"
    }
  }
}
